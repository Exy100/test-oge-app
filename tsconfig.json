{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "_astro",
    "node_modules",
    "docs/archive",
    ".lighthouseci",
    "playwright-report",
    "test-results",
    "coverage"
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node", "astro/client"]
  }
}
