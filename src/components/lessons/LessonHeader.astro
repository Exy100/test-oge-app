---
import type { LessonMetadata } from '../../lib/lessons/schema';
import { prerequisiteLinks, type LessonLink } from '../../lib/lessons/links';
import '../../styles/lessons.css';
import LessonCompletion from './LessonCompletion';
import PrintButton from '../PrintButton.astro';
import { getCollection } from 'astro:content';
import { lessonRoute } from '../../lib/lessons/catalog';
interface Props {
  lesson: LessonMetadata;
  lessons?: readonly LessonLink[];
}
const { lesson } = Astro.props;
const lessons =
  Astro.props.lessons ??
  (lesson.prerequisites.length
    ? (await getCollection('lessons')).map((entry) => ({
        id: entry.id,
        title: entry.data.title,
        route: lessonRoute(entry.data),
      }))
    : []);
const prerequisites = prerequisiteLinks(lesson.prerequisites, lessons);
---

<header class="lesson-header">
  <p class="eyebrow">
    Номера ОГЭ: {lesson.taskNumbers.join(', ')} · Чтение:{' '}
    {lesson.readingMinutes} мин
  </p>
  <h1>{lesson.title}</h1>
  <PrintButton label="Распечатать урок" />
  {prerequisites.length ? (
    <div class="lesson-prerequisites">
      <p>Перед началом повтори:</p>
      <ul>
        {prerequisites.map((link) => (
          <li>
            <a href={link.href}>{link.title}</a>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <p>Можно начать без предварительной подготовки.</p>
  )}
</header>
<LessonCompletion client:idle lessonId={lesson.id} />
<noscript>
  <p>Для сохранения отметки о прохождении включи JavaScript.</p>
</noscript>
