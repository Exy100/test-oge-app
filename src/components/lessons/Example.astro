---
import type { StreamReference } from '../../core/stream/schemas';
import { lessonTask } from '../../lib/lessons/content';
import '../../styles/rich-text.css';
import Figure from '../Figure';
import TaskFiles from '../tasks/TaskFiles';
interface Props {
  id: string;
  title: string;
  source: StreamReference;
}
const { id, title, source } = Astro.props;
const { task, statementHtml, steps } = lessonTask(source);
---

<article class="lesson-example" id={id} aria-labelledby={`${id}-title`}>
  <h3 id={`${id}-title`}>{title}</h3>
  <div class="rich-text-container">
    <div class="rich-text" set:html={statementHtml} />
  </div>
  {task.figure && (
    <Figure spec={task.figure} label={`Схема к примеру: ${title}`} />
  )}
  {task.datasetId && <TaskFiles task={task} client:visible />}
  <details data-lesson-example>
    <summary>Разобрать пример по шагам</summary>
    <ol class="lesson-steps" id={`${id}-steps`}>
      {steps.map((html, index) => (
        <li tabindex="-1">
          <h4>
            Шаг {index + 1} из {steps.length}
          </h4>
          <div class="rich-text-container">
            <div class="rich-text" set:html={html} />
          </div>
        </li>
      ))}
    </ol>
    <button
      type="button"
      class="button button-light"
      data-lesson-next
      aria-controls={`${id}-steps`}
      hidden
    >
      Следующий шаг
    </button>
    <p class="ui-sr-only" role="status" data-lesson-step-status></p>
  </details>
</article>
<script>
  for (const root of document.querySelectorAll('[data-lesson-example]')) {
    const steps = Array.from(
      root.querySelectorAll<HTMLElement>('.lesson-steps > li'),
    );
    const button = root.querySelector<HTMLButtonElement>('[data-lesson-next]');
    const status = root.querySelector('[data-lesson-step-status]');
    if (!button || !steps.length) continue;
    let visible = 1;
    for (const step of steps.slice(1)) step.dataset.lessonStepHidden = 'true';
    button.hidden = steps.length < 2;
    button.addEventListener('click', () => {
      const step = steps[visible];
      if (!step) return;
      delete step.dataset.lessonStepHidden;
      visible += 1;
      if (status)
        status.textContent = `Открыто шагов: ${String(visible)} из ${String(steps.length)}.`;
      if (visible === steps.length) {
        button.disabled = true;
        button.textContent = 'Все шаги открыты';
      }
      step.focus();
    });
  }
</script>
