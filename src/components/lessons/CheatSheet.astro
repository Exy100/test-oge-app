---
import PrintButton from '../PrintButton.astro';
interface Props {
  id?: string;
}
const { id = 'cheatsheet' } = Astro.props;
---

<section class="lesson-section" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>Шпаргалка</h2>
  <details class="lesson-cheatsheet">
    <summary>Открыть правила для повторения</summary>
    <div>
      <slot />
    </div>
  </details>
  <PrintButton label="Распечатать шпаргалку" selection="cheatsheet" />
</section>

<script>
  import '../../lib/print-details';
</script>
