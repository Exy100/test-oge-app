---
import SiteLayout from '../layouts/SiteLayout.astro';
import RichTextGallery from './RichTextGallery';
import RichText from '../components/RichText.astro';
---

<SiteLayout
  title="Проверка RichText"
  description="Проверка отображения содержимого"
  noindex
>
  <div class="container">
    <h1>Отображение содержимого</h1>
    <RichTextGallery client:load />
    <section id="server-rich-text">
      <h2>Статичный пример</h2>
      <RichText source={'```python\nprint(8 * 8)\n```'} />
    </section>
  </div>
</SiteLayout>
