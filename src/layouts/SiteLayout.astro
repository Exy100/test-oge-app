---
import '../styles/global.css';
import '../styles/print.css';
import navigationMotion from '../styles/navigation-motion.css?raw';
import themeScript from '../scripts/theme.js?raw';
import { createHash } from 'node:crypto';
import primaryFont from '../assets/fonts/golos-text-cyrillic-wght-normal.woff2?url';
import primaryLatinFont from '../assets/fonts/golos-text-latin-wght-normal.woff2?url';
import { sitePath, SITE_ORIGIN } from '../lib/site';

interface Props {
  title: string;
  description: string;
  route?: string;
  noindex?: boolean;
}
const { title, description, route = '/', noindex = false } = Astro.props;
const devPage =
  import.meta.env.DEV && Astro.url.pathname.startsWith(sitePath('/dev/'));
Astro.csp?.insertScriptHash(
  `sha256-${createHash('sha256').update(themeScript).digest('base64')}`,
);
Astro.csp?.insertStyleHash(
  `sha256-${createHash('sha256').update(navigationMotion).digest('base64')}`,
);
---

<!doctype html>
<html lang="ru" data-dev-page={devPage || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <style
      is:inline
      id="navigation-motion"
      media="(prefers-reduced-motion: no-preference)"
      set:html={navigationMotion}
    ></style>
    <script is:inline set:html={themeScript}></script>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <link
      rel="sitemap"
      type="application/xml"
      href={sitePath('/sitemap.xml')}
    />
    <link rel="canonical" href={`${SITE_ORIGIN}${sitePath(route)}`} />
    <link
      rel="preload"
      href={primaryFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={primaryLatinFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">
      К основному содержимому
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a
          class="brand"
          href={sitePath('/')}
          aria-label="Информатика ОГЭ — главная"
        >
          <span class="brand-icon" aria-hidden="true">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m5 6 6 6-6 6m9 0h5" />
            </svg>
          </span>
          <span>
            информатика<span class="brand-level">ОГЭ · 9 КЛАСС</span>
          </span>
        </a>
        <nav aria-label="Основная навигация">
          <a
            href={sitePath('/stream/')}
            aria-current={route === '/stream/' ? 'page' : undefined}
          >
            Практика
          </a>
          <a
            href={sitePath('/variants/')}
            aria-current={route.startsWith('/variants/') ? 'page' : undefined}
          >
            Варианты
          </a>
          <a
            href={sitePath('/materials/')}
            aria-current={route.startsWith('/materials/') ? 'page' : undefined}
          >
            Материалы
          </a>
          <a href={sitePath('/#exam')}>Об экзамене</a>
          <a
            href={sitePath('/about/')}
            aria-current={route === '/about/' ? 'page' : undefined}
          >
            О проекте
          </a>
        </nav>
        <div class="theme-control">
          <label for="theme-select">Тема</label>
          <select id="theme-select" data-theme-select disabled>
            <option value="system">Системная</option>
            <option value="light">Светлая</option>
            <option value="dark">Тёмная</option>
          </select>
        </div>
      </div>
    </header>
    <p
      id="storage-notice"
      class="storage-notice container"
      role="alert"
      hidden
    ></p>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <a class="footer-brand" href={sitePath('/')}>
        информатика / ОГЭ
      </a>
      <p>Учебный проект. Неофициальный сервис подготовки.</p>
      <a
        href={sitePath('/privacy/')}
        aria-current={route === '/privacy/' ? 'page' : undefined}
      >
        Конфиденциальность
      </a>
      <a
        href={sitePath('/settings/')}
        aria-current={route === '/settings/' ? 'page' : undefined}
      >
        Настройки
      </a>
      <a href={sitePath('/#practice')}>Вернуться к практике ↑</a>
      {import.meta.env.DEV && <a href={sitePath('/dev/ui/')}>Дизайн-система</a>}
    </footer>
    <script>
      import '../scripts/preferences';
      import '../lib/print-details';
    </script>
  </body>
</html>
