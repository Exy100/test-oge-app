---
import RichText from '../components/RichText.astro';
import TaskSolution from '../components/TaskSolution.astro';
import Figure from '../components/Figure';
import Practice from '../components/Practice';
import StreamProgress from '../components/StreamProgress';
import '../styles/progress.css';
import { sitePath } from '../lib/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { homeTask } from '../lib/home-practice';
import { renderRichText } from '../core/rich-text/render';

const volume = homeTask('volume', 0);
const logic = homeTask('logic', 0);
const numerals = homeTask('binary', 0);
const initialHtml = renderRichText(volume.statement);
const heroDigits = '1101';
const heroDecimal = Number.parseInt(heroDigits, 2);
const places = Array.from(heroDigits, (digit, index) => ({
  digit,
  weight: 2 ** (heroDigits.length - index - 1),
}));
const terms = places
  .filter((place) => place.digit === '1')
  .map((place) => place.weight);
---

<SiteLayout
  title="ОГЭ по информатике — практика и теория"
  description="Готовься к ОГЭ по информатике: задачи на объём текста, логику и системы счисления с проверкой ответов, подсказками и понятными решениями."
>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="live-dot" aria-hidden="true"></span> Меньше сложного.
        Больше понятного.
      </p>
      <h1 id="hero-title">
        ОГЭ по информатике.
        <br />
        <span>Шаг за шагом.</span>
      </h1>
      <p class="hero-description">
        Практикуйся в заданиях ОГЭ: проверяй краткие ответы и работай с файлами
        и кодом в своём темпе.
      </p>
      <div class="hero-actions">
        <a class="button button-dark" href={sitePath('/stream/')}>
          Начать тренировку <span aria-hidden="true">→</span>
        </a>
        <a class="hero-secondary" href="#materials">
          Сначала разобраться <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="hero-footnotes">
        <span>
          <i aria-hidden="true">✓</i> Задания №1–16
        </span>
        <span>
          <i aria-hidden="true">✓</i> Без регистрации
        </span>
      </div>
    </div>
    <div class="hero-visual">
      <div class="visual-orbit" aria-hidden="true"></div>
      <div class="number-card">
        <div class="number-card-top">
          <span class="mini-mark" aria-hidden="true">
            01
          </span>
          <span>СИСТЕМЫ СЧИСЛЕНИЯ</span>
          <span class="card-dots" aria-hidden="true">
            •••
          </span>
        </div>
        <p class="number-card-label">Одно число. Две записи.</p>
        <div
          class="number-equation"
          aria-label={`${heroDigits} в двоичной системе равно ${String(heroDecimal)} в десятичной`}
        >
          <span>
            {heroDigits}
            <sub>2</sub>
          </span>
          <span class="equation-arrow" aria-hidden="true">
            →
          </span>
          <span class="decimal-result">
            {heroDecimal}
            <sub>10</sub>
          </span>
        </div>
        <p class="bit-caption">У каждого разряда — свой вес</p>
        <div class="bit-places" aria-label="Веса двоичных разрядов">
          {places.map((place) => (
            <div class:list={['bit-place', { active: place.digit === '1' }]}>
              <strong>{place.digit}</strong>
              <span>× {place.weight}</span>
            </div>
          ))}
        </div>
        <div class="number-card-bottom">
          <span>
            {terms.join(' + ')} = <strong>{heroDecimal}</strong>
          </span>
          <span class="check-circle" aria-label="Верно">
            ✓
          </span>
        </div>
      </div>
      <p class="visual-caption">
        <span aria-hidden="true">→</span> Не магия. Просто разряды.
      </p>
    </div>
  </section>
  <div class="container">
    <StreamProgress compact client:load />
  </div>
  <section
    id="practice"
    class="practice-section"
    aria-labelledby="practice-title"
  >
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / ПРАКТИКА</p>
          <h2 id="practice-title">Знания — в дело.</h2>
        </div>
        <p>
          Выбери тему и попробуй решить. <br />
          Подсказки всегда рядом.
        </p>
      </div>
      <noscript>
        <p class="no-script">
          Для автоматической проверки включи JavaScript. Короткая теория и
          примеры с решениями ниже доступны без него.
        </p>
      </noscript>
      <p>
        <a class="button button-dark" href={sitePath('/stream/')}>
          Открыть практику №1–16 →
        </a>
      </p>
      <Practice initialHtml={initialHtml} client:visible />
      <p class="practice-caption">
        Задания №1, №3 и №10 с проверкой, подсказками и сохранением прогресса.
      </p>
    </div>
  </section>
  <section
    id="materials"
    class="materials-section container"
    aria-labelledby="materials-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / РАЗБЕРЁМСЯ</p>
        <h2 id="materials-title">Сначала — суть.</h2>
      </div>
      <p>
        Три правила, на которые можно <br />
        опереться в тренировке.
      </p>
    </div>
    <p>
      <a class="button" href={sitePath('/materials/')}>
        Открыть карту всех тем →
      </a>
    </p>
    <div class="material-grid">
      <article class="material-card">
        <div class="material-topline">
          <span class="material-symbol" aria-hidden="true">
            Aa
          </span>
          <span>ТЕМА №1</span>
        </div>
        <h3>От символов к байтам</h3>
        <p>
          Умножь число символов на объём одного символа. Если он задан в битах,
          раздели результат на 8 — столько бит в одном байте.
        </p>
        <RichText
          source={String.raw`$$\text{байты} = \frac{\text{символы} \times \text{биты}}{8}$$`}
        />
        <details>
          <summary>
            Разобрать пример <span aria-hidden="true">+</span>
          </summary>
          <div class="material-example">
            <RichText source={volume.statement} />
            <TaskSolution task={volume} />
          </div>
        </details>
      </article>
      <article class="material-card">
        <div class="material-topline">
          <span class="material-symbol violet" aria-hidden="true">
            &amp;
          </span>
          <span>ТЕМА №3</span>
        </div>
        <h3>Читай условия вместе</h3>
        <p>
          «И» требует выполнения обоих условий. «НЕ» меняет истину на ложь и
          наоборот. Знак &lt; не включает границу, а ≤ включает.
        </p>
        <div class="formula">НЕ (X &lt; a) означает X ≥ a</div>
        <details>
          <summary>
            Разобрать пример <span aria-hidden="true">+</span>
          </summary>
          <div class="material-example">
            <RichText source={logic.statement} />
            <TaskSolution task={logic} />
          </div>
        </details>
      </article>
      <article class="material-card">
        <div class="material-topline">
          <span class="material-symbol orange" aria-hidden="true">
            01
          </span>
          <span>ТЕМА №10</span>
        </div>
        <h3>Раскрой двоичную запись</h3>
        <p>
          Справа налево веса разрядов равны 1, 2, 4, 8 и так далее. Складывай
          только веса тех разрядов, в которых стоит единица.
        </p>
        <Figure
          spec={{
            kind: 'place-value',
            description: 'Разряды двоичного числа',
            base: 2,
            digits: Array.from(heroDigits, Number),
          }}
        />
        <div class="formula">
          {heroDigits}
          <sub>2</sub> = {terms.join(' + ')} = {heroDecimal}
        </div>
        <details>
          <summary>
            Разобрать пример <span aria-hidden="true">+</span>
          </summary>
          <div class="material-example">
            <RichText source={numerals.statement} />
            <TaskSolution task={numerals} />
          </div>
        </details>
      </article>
    </div>
  </section>
  <section
    id="exam"
    class="exam-section container"
    aria-labelledby="exam-title"
  >
    <div class="exam-banner">
      <div class="exam-intro">
        <p class="eyebrow">03 / ОРИЕНТИР</p>
        <h2 id="exam-title">Знай свой экзамен.</h2>
        <p>Структура по проекту ФИПИ на 2027 год.</p>
      </div>
      <dl class="exam-facts">
        <div>
          <dt>Заданий</dt>
          <dd>16</dd>
        </div>
        <div>
          <dt>Минут</dt>
          <dd>150</dd>
        </div>
        <div>
          <dt>Максимум баллов</dt>
          <dd>21</dd>
        </div>
      </dl>
    </div>
    <p class="exam-source">
      Проект может измениться. Актуальные документы —{' '}
      <a
        href="https://fipi.ru/oge/demoversii-specifikacii-kodifikatory"
        target="_blank"
        rel="noopener noreferrer"
      >
        на сайте ФИПИ <span aria-hidden="true">→</span>
      </a>
      .
    </p>
  </section>
</SiteLayout>
