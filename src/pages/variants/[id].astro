---
import InfoLayout from '../../layouts/InfoLayout.astro';
import VariantTask from '../../components/variants/VariantTask.astro';
import ExamEntry from '../../components/variants/ExamEntry';
import {
  buildFixedVariant,
  fixedVariants,
  variant13Alternatives,
  variantSeed,
} from '../../core/variants';
import { sitePath } from '../../lib/site';
import '../../styles/variants.css';
import '../../styles/exam.css';
export function getStaticPaths() {
  return fixedVariants.map(({ id }) => ({ params: { id } }));
}
const id = Astro.params.id as string;
const variant = buildFixedVariant(id);
const alternatives = variant13Alternatives(variantSeed(variant));
---

<InfoLayout
  title={`Вариант ${id}`}
  description="Пройди вариант с таймером или открой нужное задание для работы в практике."
  route={`/variants/${id}/`}
>
  <noscript>
    Для прохождения с таймером включи JavaScript. Условия ниже можно читать без
    него.
  </noscript>
  <ExamEntry variantId={variant.id} seed={variantSeed(variant)} client:load>
    <p>
      <a href={sitePath('/variants/')}>← Все варианты</a>
    </p>
    <p>
      Всего 16 заданий. В №13 выбери одну работу: презентацию или документ.
      Задания №15 и №16 выполняются оба.
    </p>
    <div class="variant-tasks">
      {variant.tasks.map((task) => (
        <details
          class="variant-task"
          open={task.taskNumber === 1}
          data-task-number={task.taskNumber}
        >
          <summary>
            <h2>Задание №{task.taskNumber}</h2>
          </summary>
          <div class="variant-task-body">
            {task.taskNumber === 13 ? (
              <>
                <VariantTask task={alternatives.presentation} />
                <VariantTask task={alternatives.document} />
              </>
            ) : (
              <VariantTask task={task} />
            )}
          </div>
        </details>
      ))}
    </div>
  </ExamEntry>
</InfoLayout>
