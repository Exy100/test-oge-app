| Д | 0 | 0 | 1 | 1 | 0 | 0 | 0 |
| Е | 0 | 0 | 0 | 0 | 0 | 0 | 1 |
| Ж | 0 | 0 | 0 | 0 | 0 | 0 | 0 |

