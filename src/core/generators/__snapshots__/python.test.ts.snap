exports[`python-filter-v1 > golden task and manifest golden-2 1`] = `
{
  "answer": {
    "kind": "program",
    "referenceId": "python-filter-v1:golden-2:reference",
    "type": "artifact",
  },
  "commonMistakes": [
    {
