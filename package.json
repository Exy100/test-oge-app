{
  "name": "oge-informatics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "lighthouse": "13.5.0",
    "basic-ftp": "6.2.2",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "astro dev --ignore-lock",
    "build": "astro build",
    "preview": "astro preview --ignore-lock",
    "preview:secure": "node scripts/test-tls.mjs && OGE_TEST_HTTPS=1 astro preview --ignore-lock --host 127.0.0.1 --port 4322",
    "preview:headers": "node scripts/test-tls.mjs && node scripts/stage-pages.mjs && wrangler pages dev .cache/pages --ip 127.0.0.1 --port 4326 --compatibility-date 2026-10-01 --local-protocol https --https-key-path .cache/test-tls/key.pem --https-cert-path .cache/test-tls/cert.pem",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "lh": "npm run build && lhci autorun && node scripts/check-interactions.mjs",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run check:forbidden && npm run check:coverage && npm run check:contrast && npm run build && npm run check:security",
    "check:robots": "python3 scripts/check-robots.py",
    "check:python": "python3 scripts/check-python.py",
    "check:variants": "python3 scripts/check-variants.py",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:security": "node scripts/check-dist-secrets.mjs",
    "sample": "node scripts/sample-tasks.mjs",
    "sample:variant": "node scripts/sample-variant.mjs",
    "sample:dataset": "node scripts/sample-dataset.mjs",
    "check:office": "npm run sample:dataset && python3 scripts/check-office.py && python3 scripts/check-presentations.py && python3 scripts/check-documents.py && python3 scripts/check-spreadsheets.py && npm run check:office-lessons",
    "check:office-lessons": "node scripts/sample-office-lessons.mjs && python3 scripts/check-office-lessons.py",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "isomorphic-dompurify": "4.5.0",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "1.63.0",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "fast-xml-validator": "1.4.2",
    "globals": "17.13.0",
    "lighthouse": "13.5.0",
    "miniflare": "5.20261001.0-alpha",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "puppeteer-core": "25.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "web-vitals": "6.2.3",
    "wrangler": "4.147.0",
    "yaml": "2.9.1"
  }
}
