{
  "name": "oge-informatics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "lighthouse": "13.5.0",
    "basic-ftp": "6.2.2",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "astro dev --ignore-lock",
    "build": "astro build",
    "preview": "astro preview --ignore-lock",
    "preview:secure": "node scripts/test-tls.mjs && OGE_TEST_HTTPS=1 astro preview --ignore-lock --host 127.0.0.1 --port 4322",
    "preview:headers": "node scripts/test-tls.mjs && node scripts/stage-pages.mjs && wrangler pages dev .cache/pages --ip 127.0.0.1 --port 4326 --compatibility-date 2026-10-01 --local-protocol https --https-key-path .cache/test-tls/key.pem --https-cert-path .cache/test-tls/cert.pem",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "lh": "npm run build && lhci autorun",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run check:forbidden && npm run check:coverage && npm run check:contrast && npm run build",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "miniflare": "5.20261001.0-alpha",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0",
    "yaml": "2.9.1"
  }
}
