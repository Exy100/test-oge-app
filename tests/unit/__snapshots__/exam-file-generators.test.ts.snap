exports[`file-extensions-v2 > golden golden-2 1`] = `
{
  "answer": {
    "type": "integer",
    "value": "11",
  },
  "commonMistakes": [
    {
      "answer": "10",
      "explanation": "Пропущен файл. Проверь вложенные папки и все перечисленные расширения.",
    },
    {
      "answer": "22",
      "explanation": "Результаты нельзя удваивать: каждый полный путь считается один раз.",
    },
  ],
  "datasetId": "file-extensions-v2:files:golden-2",
  "difficulty": 3,
  "examPart": 2,
  "generatorId": "file-extensions-v2",
  "hints": [
    "Проверь корни поиска и все вложенные папки.",
    "Если расширений несколько, объедини результаты поиска.",
    "Считай файлы, а не папки; одинаковые имена в разных папках — разные файлы.",
  ],
  "id": "file-extensions-v2:golden-2",
  "seed": "golden-2",
  "solution": [
    {
      "text": "В каждом указанном каталоге включи поиск во вложенных папках. Отбирай .htm по расширению файла.",
    },
    {
      "text": "Подходящие файлы:

- Иллюстрации/Нина Речная/Черновики/работа-16.htm
- Иллюстрации/Нина Речная/работа-08.htm
- Иллюстрации/Олег Ветров/Черновики/работа-04.htm
- Иллюстрации/Олег Ветров/работа-12.htm
- Проза-архив/Ирина Полевая/Черновики/работа-06.htm
- Проза-архив/Ирина Полевая/работа-14.htm
- Проза/Нина Речная/Черновики/работа-01.htm
- Проза/Нина Речная/работа-09.htm
- Проза/Нина Речная/работа-17.htm
- Проза/Олег Ветров/Черновики/работа-13.htm
- Проза/Олег Ветров/работа-05.htm",
    },
    {
      "text": "Всего 11 файлов. Одинаковые имена в разных каталогах обозначают разные файлы; каждый полный путь учтён один раз.",
    },
  ],
  "statement": "Скачай и распакуй файловый набор. Сколько файлов с расширением .htm находится в следующих каталогах, включая все вложенные папки?

- Проза-архив/Ирина Полевая
- Иллюстрации/Нина Речная
- Иллюстрации/Олег Ветров
- Проза

Другие каталоги не учитывай.",
  "subtype": "file-extensions",
  "taskNumber": 12,
  "topics": [
    "Отбор и объём файлов",
  ],
}
`;

